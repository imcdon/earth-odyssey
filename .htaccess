# Earth Odyssey - URL rewrites and routing
RewriteEngine On

# Private folders: never served over the web (PHP include() still reads them)
RewriteRule ^(includes|database|storage|cron|scripts|_raw|node_modules|\.git|\.cursor)(/|$) - [F,L]

# Private files: SQL dumps, logs, archives, dotfiles, and package manifests
<FilesMatch "(\.(sql|log|zip|md|lock)|^\..*|^package(-lock)?\.json)$">
    Require all denied
</FilesMatch>

# Clean article URLs: /articles/slug/ -> article.php?slug=slug
RewriteRule ^articles/([a-z0-9-]+)/?$ articles/article.php?slug=$1 [L,QSA]

# Galleries and services: all paths -> coming soon placeholder
RewriteRule ^galleries(/.*)?$ galleries/index.php [L,QSA]
RewriteRule ^services(/.*)?$ services/index.php [L,QSA]
